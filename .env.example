# Required for reading recommendations (recommend/search.py).
# Every other stage works fully offline.
TAVILY_API_KEY=

# Optional: only needed if Ollama is not running on its default host/port.
# OLLAMA_HOST=http://127.0.0.1:11434

# --- Reel Inbox extractor (python -m reel_inbox) ---
# Browsers to read cookies from, in order. Chrome/Edge often fail on Windows
# (locked, app-bound-encrypted cookie store).
# REEL_COOKIE_BROWSERS=firefox,chrome
# Fallback: a Netscape-format cookies.txt exported from a logged-in browser.
# Keep it outside the repo.
# REEL_COOKIES_FILE=C:\Users\you\secrets\instagram-cookies.txt
# REEL_WHISPER_MODEL=small
# REEL_WHISPER_DEVICE=cpu        # cuda to opt in to the GPU
# REEL_WHISPER_COMPUTE=int8      # float16 with cuda
# REEL_LLM_MODEL=qwen3:8b
# REEL_OCR=0                     # 1 to OCR a few frames per reel
